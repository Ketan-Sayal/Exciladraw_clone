generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  password String
  username String
  shapes Shape[]
  rooms Room[]
}

model Shape{
  id String @id @default(uuid())
  userId Int
  user User @relation(fields: [userId], references: [id])
  shapeData String
  roomId Int
  room   Room @relation(fields: [roomId], references: [id])
}

model Room{
  userId Int
  user User @relation(fields: [userId], references: [id])
  shapes Shape[]
  id Int @id @default(autoincrement())
}